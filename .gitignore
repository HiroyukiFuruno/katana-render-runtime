/target
# crate単体実行で作られるCargo出力も管理外に保持する。
/crates/*/target/
# 単発のrustc出力とLLVM計測データはソースではなく生成物。
/rust_out
/*.profraw
tmp
.katana-krr-browser-*.html
**/*.rs.bk
Cargo.lock.bak
.DS_Store
.idea/
.vscode/
*.swp
node_modules

# moon の生成cacheは設定・検証コードと分離する。
/.moon/cache/
/.moon/schemas/

# Python
__pycache__/
*.py[cod]
*$py.class

# openspec workfiles
openspec*
!openspec/
!openspec/**
openspec/**/.DS_Store
opsx*
!/scripts/openspec
