{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "resolvePackageJsonImports": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "types": ["node", "bun"]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/fixtures/quality-cache/*.ts",
    "crates/katana-render-runtime/src/markdown/diagram_runtime/source/**/*.ts"
  ],
  "exclude": [
    "crates/katana-render-runtime/src/markdown/diagram_runtime/generated/**",
    "crates/katana-render-runtime/vendor/**",
    "target/**",
    "tmp/**"
  ]
}
