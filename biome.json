{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "scripts/**/*.ts",
      "crates/katana-render-runtime/src/markdown/mermaid_renderer/**/*.js",
      "crates/katana-render-runtime/src/markdown/drawio_renderer/js_runtime/*.js",
      "crates/katana-render-runtime/src/markdown/mathjax_renderer/**/*.js",
      "crates/katana-render-runtime/src/markdown/mathjax_renderer/js_runtime/host_mathjax.d.ts",
      "crates/katana-render-runtime/src/renderer/backends/html_runtime/parser_body_onload.ts",
      "crates/katana-render-runtime/src/renderer/backends/html_runtime/host_parser_onload.d.ts",
      "scripts/quality/tsconfig-owned-*.json",
      "docs/performance/*.json",
      "crates/katana-render-runtime/tests/fixtures/html_browser/resources/action.js",
      "scripts/runtime-bundles/runtime-css-variables.js",
      "tests/fixtures/quality-cache/*.ts",
      "crates/katana-render-runtime/src/markdown/diagram_runtime/source/**/*.ts",
      "crates/katana-render-runtime/src/renderer/backends/html_runtime/**/*.js",
      "!crates/katana-render-runtime/src/markdown/diagram_runtime/generated",
      "!crates/katana-render-runtime/vendor",
      "!target",
      "!tmp",
      "crates/katana-render-runtime/src/markdown/mermaid_renderer/js_runtime_native_width_trace_host.d.ts",
      "crates/katana-render-runtime/src/markdown/mermaid_renderer/js_runtime/browser_reference_host.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/html/playwright.config.ts", "scripts/html/playwright.macos.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
